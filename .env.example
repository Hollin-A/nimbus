# Compose-level environment for `docker compose up`. Copy this file to
# `.env` (which is gitignored) and replace JWT_SECRET with a real value
# before the first run.
#
# Per-service env (the inner backend/.env and frontend/.env) is for the
# local `npm run dev` flow and is separate from this file.

# JWT signing secret — REPLACE with a long random value. Suggested:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-real-secret

# Postgres password for the compose `postgres` service (the backend's
# DATABASE_URL is derived from it). REPLACE with a real value.
POSTGRES_PASSWORD=replace-me-too
