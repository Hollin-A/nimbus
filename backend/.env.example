# API port
PORT=4000

# Runtime mode: development | production | test
NODE_ENV=development

# JWT signing secret — REPLACE in production with a long random value
JWT_SECRET=dev-only-change-me

# Access-token lifetime — kept short; refresh tokens keep the session
# alive (e.g. 15m, 30m).
JWT_EXPIRES_IN=15m

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# Postgres connection — for local dev this points at the compose
# `postgres` service exposed on localhost (docker compose up postgres).
DATABASE_URL=postgresql://nimbus:replace-me-too@localhost:5432/nimbus
